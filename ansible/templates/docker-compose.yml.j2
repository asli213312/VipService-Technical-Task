# VipService stack: demo app (backend+nginx) + monitoring (prometheus/grafana/exporters).
# This file is rendered by Ansible; do not edit the copy on the server manually.
# Fixed project name: redeploy from any directory updates the SAME stack,
# preventing container-name and port conflicts between deployments.
name: {{ project_name }}

services:
  # Demo application backend (hashicorp/http-echo)
  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
      args:
        HASHICORP_HTTP_VERSION: {{ hashicorp_http_version }}
    container_name: backend
    restart: unless-stopped
    networks:
      - app
    mem_limit: {{ backend_mem_limit }}

  nginx:
    build:
      context: ./nginx
      dockerfile: Dockerfile
      args:
        NGINX_VERSION: {{ nginx_version }}
    container_name: nginx
    restart: unless-stopped
    ports:
      - "{{ nginx_port }}:80"
    depends_on:
      - backend
    networks:
      - app
    volumes:
      - ./nginx/logs:/var/log/nginx
    mem_limit: {{ nginx_mem_limit }}

  prometheus:
    image: prom/prometheus:{{ prometheus_version }}
    container_name: prometheus
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
    networks:
      - app
    restart: unless-stopped
    mem_limit: {{ prometheus_mem_limit }}

  grafana:
    image: grafana/grafana:{{ grafana_version }}
    container_name: grafana
    ports:
      - "3000:3000"
    environment:
      # Credentials are injected from .env at compose startup (no secrets in VCS-tracked yaml).
      - GF_SECURITY_ADMIN_USER=${GRAFANA_ADMIN_USER}
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD}
    volumes:
      - grafana-data:/var/lib/grafana
      - ./grafana/dashboards:/etc/grafana/provisioning/dashboards:ro
      - ./grafana/datasources:/etc/grafana/provisioning/datasources:ro
    depends_on:
      - prometheus
    networks:
      - app
    restart: unless-stopped
    mem_limit: {{ grafana_mem_limit }}

  nginx-exporter:
    image: nginx/nginx-prometheus-exporter:{{ nginx_exporter_version }}
    container_name: nginx-exporter
    command:
      - -nginx.scrape-uri=http://nginx:80/status
    depends_on:
      - nginx
    networks:
      - app
    restart: unless-stopped
    mem_limit: {{ nginx_exporter_mem_limit }}

  nginxlog-exporter:
    image: quay.io/martinhelmich/prometheus-nginxlog-exporter:{{ nginxlog_exporter_version }}
    container_name: nginxlog-exporter
    restart: unless-stopped
    volumes:
      - ./nginx/logs:/var/log/nginx:ro
      - ./nginx/nginxlog/nginxlog.hcl:/etc/nginxlog/nginxlog.hcl:ro
    command:
      - -config-file=/etc/nginxlog/nginxlog.hcl
    networks:
      - app
    mem_limit: {{ nginxlog_exporter_mem_limit }}

  cadvisor:
    image: gcr.io/cadvisor/cadvisor:{{ cadvisor_version }}
    container_name: cadvisor
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
    privileged: true
    networks:
      - app
    mem_limit: {{ cadvisor_mem_limit }}
    
  loki:
    image: grafana/loki:{{ loki_version }}
    container_name: loki
    restart: unless-stopped
    volumes:
      - loki-data:/loki
    networks:
      - app
    mem_limit: {{ loki_mem_limit }}
    
  promtail:
    image: grafana/promtail:{{ promtail_version }}
    container_name: promtail
    restart: unless-stopped
    volumes:
      - ./loki/promtail.yml:/etc/promtail/config.yml:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /var/lib/docker/containers:/var/lib/docker/containers:ro
      - ./nginx/logs:/var/log/nginx-host:ro
    depends_on:
      - loki
    networks:
      - app
    mem_limit: {{ promtail_mem_limit }}

volumes:
  prometheus-data:
  grafana-data:
  loki-data:

networks:
  app:
    driver: bridge